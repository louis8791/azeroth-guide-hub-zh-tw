{
  "name": "azeroth-guide-hub-zh-tw",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "crawl": "node scripts/crawl-sources.mjs --tier=all",
    "crawl:urgent": "node scripts/crawl-sources.mjs --tier=urgent",
    "crawl:guides": "node scripts/crawl-sources.mjs --tier=guides",
    "crawl:stats": "node scripts/crawl-sources.mjs --tier=stats",
    "crawl:questions": "node scripts/crawl-sources.mjs --tier=questions",
    "crawl:backfill": "node scripts/crawl-sources.mjs --tier=backfill",
    "translate": "../icy-veins-zh-tw/.venv/bin/python scripts/translate-content.py --provider=argos",
    "translate:argos": "../icy-veins-zh-tw/.venv/bin/python scripts/translate-content.py --provider=argos",
    "translate:m2m100": "python3 scripts/translate-content.py --provider=m2m100",
    "translate:ollama": "python3 scripts/translate-content.py --provider=ollama",
    "translate:fallback": "python3 scripts/translate-content.py --provider=fallback",
    "refresh": "npm run crawl && npm run translate",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
